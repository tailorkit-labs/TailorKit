{
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "turbo run dev --filter=web",
    "dev:docs": "cd docs && mint dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:studio": "turbo run db:studio --filter=@tailorkit/db",
    "db:generate": "turbo run db:generate --filter=@tailorkit/db",
    "db:migrate": "turbo run db:migrate --filter=@tailorkit/db",
    "services:start": "docker compose up -d",
    "services:watch": "docker compose up",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "check": "turbo run quality",
    "fix": "turbo run quality:fix",
    "sherif": "sherif -r packages-without-package-json",
    "sherif:fix": "sherif -r packages-without-package-json --fix --select highest --no-install",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "format": "vp fmt --check",
    "format:fix": "vp fmt .",
    "licenses:sync": "node ./scripts/sync-licenses.mjs",
    "licenses:check": "node ./scripts/sync-licenses.mjs --check",
    "changeset": "vp exec changeset",
    "release:status": "vp exec changeset status --verbose",
    "release:version": "vp exec changeset version",
    "release:build": "turbo run build --filter=tailorkit --filter=@tailorkit/app --filter=@tailorkit/cli --filter=@tailorkit/client-platform --filter=@tailorkit/core --filter=@tailorkit/react --filter=@tailorkit/sandbox",
    "release:publish": "vp run release:build && node ./scripts/check-prerelease.mjs && vp exec changeset publish",
    "tailorkit": "vp -C packages/cli build && node ./packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "mint": "^4.2.970",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "sherif": "^1.13.0",
    "turbo": "2.11.6",
    "ultracite": "7.12.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.9.1"
}
