{
  "description": "Format files after Codex edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/format-after-edit.mjs\"",
            "statusMessage": "Formatting edited files"
          }
        ]
      }
    ]
  }
}
