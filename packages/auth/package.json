{
  "name": "@tailorkit/auth",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/lib/email.ts src/lib/permissions.ts src/lib/public-team-id.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "generate": "auth generate --config src/index.ts --output ../db/src/schema/auth.generated.ts --yes",
    "test": "vp test run"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.5",
    "@better-auth/core": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/infra": "^0.4.11",
    "@better-auth/passkey": "1.7.5",
    "@simplewebauthn/server": "^13.3.1",
    "@tailorkit/db": "workspace:*",
    "@tailorkit/email": "workspace:*",
    "@tailorkit/env": "workspace:*",
    "@tailorkit/kv": "workspace:*",
    "@tailorkit/observability": "workspace:*",
    "@vercel/functions": "^3.9.9",
    "better-auth": "catalog:",
    "jose": "6.2.12",
    "nanoid": "^6.0.1",
    "uuid": "^14.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "auth": "1.7.5",
    "typescript": "catalog:"
  }
}
