{
  "name": "@tailorkit/app",
  "version": "0.1.0-beta.15",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlfieJones/tailorkit.git",
    "directory": "packages/app"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config.js"
    },
    "./config/loader": {
      "types": "./dist/config/loader.d.ts",
      "import": "./dist/config-loader.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/copy-facet.mjs && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@tailorkit/app-storage": "workspace:*",
    "@tailorkit/apps-server": "workspace:*",
    "@tailorkit/core": "workspace:*",
    "cosmiconfig": "^10.0.1",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/asset-delivery": "workspace:*",
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "preact": "^10.29.8",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  }
}
