{
  "name": "@tailorkit/ui",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": {
      "development": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.mjs"
    },
    "./components/*": {
      "development": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.mjs"
    },
    "./hooks/*": {
      "development": "./src/hooks/*.ts",
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.mjs"
    },
    "./forms/*": {
      "development": [
        "./src/forms/*.ts",
        "./src/forms/*.tsx"
      ],
      "types": "./dist/forms/*.d.ts",
      "default": "./dist/forms/*.mjs"
    },
    "./form": {
      "development": "./src/forms/form.tsx",
      "types": "./dist/forms/form.d.ts",
      "default": "./dist/forms/form.mjs"
    },
    "./*": {
      "development": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.mjs"
    }
  },
  "scripts": {
    "build": "vp pack 'src/**/*.ts' 'src/**/*.tsx' --format esm --clean --unbundle --no-dts --deps.never-bundle @tailorkit/ui && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/form-core": "1.33.5",
    "@tanstack/react-form": "^1.33.5",
    "class-variance-authority": "catalog:",
    "cn": "0.4.0",
    "dayjs": "^1.11.23",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
