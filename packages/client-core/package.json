{
  "name": "@tailorkit/client-core",
  "version": "0.1.0-beta.18",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailorkit-labs/TailorKit.git",
    "directory": "packages/client-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client.js"
    },
    "./store/fetch": {
      "types": "./dist/store/fetch/index.d.ts",
      "import": "./dist/store-fetch.js"
    },
    "./store/local": {
      "types": "./dist/store/local/index.d.ts",
      "import": "./dist/store-local.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --entry.index src/index.ts --entry.client src/client/index.ts --entry.store-fetch src/store/fetch/index.ts --entry.store-local src/store/local/index.ts --format esm --target node20 --clean && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@tailorkit/app": "workspace:*",
    "@tailorkit/client-platform": "workspace:*",
    "@tailorkit/core": "workspace:*",
    "@tailorkit/sandbox": "workspace:*",
    "@tanstack/store": "0.11.2"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  }
}
