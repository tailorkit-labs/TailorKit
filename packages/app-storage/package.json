{
  "name": "@tailorkit/app-storage",
  "version": "0.1.0-beta.15",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./tooling": {
      "types": "./dist/tooling.d.ts",
      "import": "./dist/tooling.js"
    },
    "./orchestration": {
      "types": "./dist/orchestration.d.ts",
      "import": "./dist/orchestration.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/auth.ts src/host.ts src/runtime.ts src/tooling.ts src/orchestration.ts --format esm --target node20 --clean && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@standard-schema/spec": "^1.1.0",
    "drizzle-kit": "1.0.0-rc.4-5d5b77c",
    "drizzle-orm": "catalog:",
    "effect": "4.0.0-rc.117",
    "jose": "6.2.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
