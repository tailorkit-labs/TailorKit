{
  "name": "@tailorkit/api",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/context.ts src/procedures.ts src/routers/index.ts src/routers/apps.ts src/routers/org.ts src/routers/project.ts src/routers/user.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@tailorkit/api-utils": "workspace:*",
    "@tailorkit/auth": "workspace:*",
    "@tailorkit/db": "workspace:*",
    "@tailorkit/env": "workspace:*",
    "@tailorkit/kv": "workspace:*",
    "@tailorkit/observability": "workspace:*",
    "@vercel/functions": "^3.9.9",
    "drizzle-orm": "catalog:",
    "nanoid": "^6.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
