import { createView, useQuery } from "tailorkit/client";
import { api{% if useBox %}, Box{% endif %} } from "#tailorkit";
{% if multiple %}import { z } from "zod";
{% endif %}

const view = createView({{ viewPath }}, {
  slot: {{ slotName }},
{% if multiple %}  instances: {
    dataSchema: z.object({}),
    resolve: () => [{ key: "default", metadata: { title: "Default" }, data: {} }],
  },
{% endif %}
  component: ViewComponent,
});

function ViewComponent() {
  const greeting = useQuery(api.greeting, { name: "TailorKit" });

  return <{% if useBox %}Box{% endif %}>{greeting.isLoading ? "Loading…" : greeting.error?.message ?? greeting.data}</{% if useBox %}Box{% endif %}>;
}

export default view;
