import { createView, useQuery } from "tailorkit/client";
import { api, Card } from "#tailorkit";

const view = createView("/", {
  component: ViewComponent,
});

function ViewComponent() {
  const context = view.useContext();
  const greeting = useQuery(api.greeting, { name: context.user.name });

  return <Card>{greeting.isLoading ? "Loading…" : greeting.error?.message ?? greeting.data}</Card>;
}

export default view;
