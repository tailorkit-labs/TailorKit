{
  "name": "@tailorkit/api-utils",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    "./rate-limiting": {
      "development": "./src/rate-limiting.ts",
      "types": "./dist/rate-limiting.d.mts",
      "default": "./dist/rate-limiting.mjs"
    },
    "./hashing": {
      "development": "./src/hashing.ts",
      "types": "./dist/hashing.d.mts",
      "default": "./dist/hashing.mjs"
    },
    "./dev-delay": {
      "development": "./src/dev-delay.ts",
      "types": "./dist/dev-delay.d.mts",
      "default": "./dist/dev-delay.mjs"
    },
    "./app-asset-url": {
      "development": "./src/app-asset-url.ts",
      "types": "./dist/app-asset-url.d.mts",
      "default": "./dist/app-asset-url.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/rate-limiting.ts src/hashing.ts src/dev-delay.ts src/app-asset-url.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/experimental-ratelimit": "^1.15.4",
    "@orpc/server": "catalog:",
    "@tailorkit/env": "workspace:*",
    "@tailorkit/kv": "workspace:*",
    "@tailorkit/observability": "workspace:*",
    "@upstash/ratelimit": "^2.2.0",
    "@vercel/functions": "^3.9.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
