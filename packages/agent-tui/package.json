{
  "name": "@tailorkit/agent-tui",
  "version": "0.1.0-beta.17",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/tui.ts --format esm --dts --clean --deps.never-bundle @opentui/core --deps.never-bundle eve",
    "check-types": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@opentui/core": "0.5.14",
    "eve": "0.68.0",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
