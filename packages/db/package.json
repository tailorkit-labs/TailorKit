{
  "name": "@tailorkit/db",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/relations.ts src/validate-org-slug.ts src/validate-project-slug.ts src/schema/index.ts src/schema/apps.ts src/schema/auth.ts src/schema/cli-auth.ts src/schema/preview-session.ts src/schema/project.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "drizzle-kit": "node --conditions=development --preserve-symlinks-main ./node_modules/drizzle-kit/bin.cjs",
    "db:push": "pnpm drizzle-kit push",
    "db:generate": "pnpm drizzle-kit generate",
    "db:studio": "pnpm drizzle-kit studio --port 4020",
    "db:migrate": "pnpm drizzle-kit migrate"
  },
  "dependencies": {
    "@tailorkit/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "1.0.0-rc.4-5d5b77c",
    "typescript": "catalog:"
  }
}
