{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tailorkit-assets",
  "main": "src/index.ts",
  // Workers Builds invokes Wrangler directly, without Turbo's dependency builds.
  "build": {
    "command": "pnpm --filter @tailorkit/asset-delivery build",
    "watch_dir": ["src", "../../packages/asset-delivery/src"],
  },
  // Match the latest date supported by the pinned local workerd runtime.
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "*.tailorkit.app/*", "zone_name": "tailorkit.app" }],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "tailorkit-app-assets-prod" }],
  "vars": {
    "ASSET_DOMAIN": "tailorkit.app",
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
