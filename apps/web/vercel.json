{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "buildCommand": "TURBO_PLATFORM_ENV_DISABLED=true turbo run build --filter=web...",
  "installCommand": "PNPM_CONFIG_CACHE_DIR=node_modules/.cache/pnpm pnpm install --filter web...",
  "fluid": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "https://tailorkit-docs.vercel.app",
      "missing": [
        {
          "type": "cookie",
          "key": "__Secure-tailorkit.session_token"
        },
        {
          "type": "cookie",
          "key": "__Secure-tailorkit-dev.session_token"
        }
      ]
    },
    {
      "source": "/home",
      "destination": "https://tailorkit-docs.vercel.app/home"
    },
    {
      "source": "/docs",
      "destination": "https://tailorkit-docs.vercel.app/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://tailorkit-docs.vercel.app/docs/:path*"
    },
    {
      "source": "/_serverFn/docs_:path",
      "destination": "https://tailorkit-docs.vercel.app/_serverFn/docs_:path"
    },
    {
      "source": "/docs-assets/:path*",
      "destination": "https://tailorkit-docs.vercel.app/docs-assets/:path*"
    }
  ]
}
